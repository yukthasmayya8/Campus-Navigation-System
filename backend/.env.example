NODE_ENV=development
PORT=4000
# PostgreSQL with PostGIS (Neon / Supabase / Render / local). Use ?sslmode=require for hosted DBs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_nav
DATABASE_SSL=false
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# Seed script (first Super Admin). Password is forced to change on first login.
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@example.edu
SUPERADMIN_PASSWORD=ChangeMe-12345
# Images: "local" for development only. Hosted demo needs persistent external storage (see storage.js)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000
MAX_IMAGE_MB=3
# Duplicate-location check radius in metres (PostGIS ST_DWithin)
DUPLICATE_RADIUS_M=15
# Password reset e-mail (optional; without SMTP the reset link is logged to the server console in development)
SMTP_URL=
MAIL_FROM=Campus Navigation <no-reply@example.edu>
FRONTEND_URL=http://localhost:5173
